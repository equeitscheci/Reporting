# Copy to .env and adjust. Secrets are NEVER stored in config files — only references (vault://...).

# --- Backend ---
INSIGHTFORGE_ENVIRONMENT=dev
INSIGHTFORGE_AUTH_DISABLED=true                 # MUST be false in production (enables OIDC/JWT)
INSIGHTFORGE_WAREHOUSE_DSN=postgresql://insightforge:insightforge@localhost:5432/insightforge
INSIGHTFORGE_TENANTS_DIR=./config/tenants

# --- Secrets backend: env | file | aws_secrets_manager ---
INSIGHTFORGE_SECRETS_BACKEND=env
INSIGHTFORGE_SECRETS_FILE=./config/secrets.dev.json

# Example resolved secret for a vault reference vault://acme-mfg/epicor/client_id
# (env backend maps the path to AN UPPERCASE __ DELIMITED VAR):
# ACME_MFG__EPICOR__CLIENT_ID=...
# ACME_MFG__EPICOR__CLIENT_SECRET=...

# --- Optional ECI AI Studio agent bridge ---
# When unset, /insights/ask uses the built-in deterministic semantic NLQ engine.
# When set, /insights/ask sends the local governed answer and metric catalog as context.
# INSIGHTFORGE_AI_STUDIO_AGENT_URL=https://...
# INSIGHTFORGE_AI_STUDIO_API_KEY=...
# INSIGHTFORGE_AI_STUDIO_AGENT_ID=...
# INSIGHTFORGE_AI_STUDIO_TIMEOUT_SECONDS=15

# --- dbt (warehouse) ---
PGHOST=localhost
PGUSER=insightforge
PGPASSWORD=insightforge
PGDATABASE=insightforge
