{
  "id": "mfg-overview",
  "title": "Manufacturing — Job Profitability & Efficiency",
  "industry": "manufacturing",
  "filters": {},
  "layout": { "columns": 12 },
  "widgets": [
    {
      "id": "kpi-revenue",
      "type": "kpi",
      "title": "Revenue (period)",
      "metric": "revenue",
      "dimensions": [],
      "grid": { "x": 0, "y": 0, "w": 3, "h": 2 }
    },
    {
      "id": "kpi-margin",
      "type": "kpi",
      "title": "Gross Margin %",
      "metric": "gross_margin_pct",
      "dimensions": [],
      "grid": { "x": 3, "y": 0, "w": 3, "h": 2 }
    },
    {
      "id": "kpi-orders",
      "type": "kpi",
      "title": "Orders",
      "metric": "order_count",
      "dimensions": [],
      "grid": { "x": 6, "y": 0, "w": 3, "h": 2 }
    },
    {
      "id": "kpi-aov",
      "type": "kpi",
      "title": "Avg Order Value",
      "metric": "avg_order_value",
      "dimensions": [],
      "grid": { "x": 9, "y": 0, "w": 3, "h": 2 }
    },
    {
      "id": "margin-trend",
      "type": "line",
      "title": "Gross Margin % Trend (WIP profitability signal)",
      "metric": "gross_margin_pct",
      "dimensions": ["month"],
      "grid": { "x": 0, "y": 2, "w": 8, "h": 4 }
    },
    {
      "id": "job-profitability",
      "type": "bar",
      "title": "Job Margin % by Customer",
      "metric": "job_margin_pct",
      "dimensions": ["customer_name"],
      "order_by": "value",
      "limit": 8,
      "grid": { "x": 8, "y": 2, "w": 4, "h": 4 }
    },
    {
      "id": "margin-by-group",
      "type": "bar",
      "title": "Gross Margin $ by Product Group",
      "metric": "gross_margin",
      "dimensions": ["product_group"],
      "order_by": "value",
      "grid": { "x": 0, "y": 6, "w": 6, "h": 4 }
    },
    {
      "id": "revenue-trend",
      "type": "line",
      "title": "Revenue Trend",
      "metric": "revenue",
      "dimensions": ["month"],
      "grid": { "x": 6, "y": 6, "w": 6, "h": 4 }
    }
  ]
}
